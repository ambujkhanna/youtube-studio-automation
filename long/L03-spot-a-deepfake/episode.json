            "cue": "blurry",
            "ok": false
          }
        ]
      }
    },
    {
      "who": "DAD",
      "text": "What else?"
    },
    {
      "who": "TEEN",
      "text": "Lighting and shadows that don't match, blinking that looks off, and lips that don't quite match the words.",
      "board": {
        "type": "gallery",
        "title": "MORE CLUES",
        "items": [
          {
            "icon": "💡",
            "label": "Lighting",
            "cue": "lighting"
