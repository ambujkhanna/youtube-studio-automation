    {
      "who": "DAD",
      "text": "So how do I spot one with my own eyes?",
      "chapter": "Look and listen"
    },
    {
      "who": "TEEN",
      "text": "Look closely at the details. Hands with odd fingers, strange teeth or earrings, and blurry edges around the face or hair.",
      "board": {
        "type": "checklist",
        "title": "LOOK FOR",
        "icon": "eye",
        "items": [
          {
            "text": "Odd fingers",
            "cue": "fingers",
            "ok": false
          },
