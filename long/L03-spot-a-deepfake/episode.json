            "cue": "learns"
          },
          {
            "icon": "🎭",
            "label": "Makes a fake",
            "cue": "makes"
          }
        ]
      }
    },
    {
      "who": "DAD",
      "text": "And anyone can do this?"
    },
    {
      "who": "TEEN",
