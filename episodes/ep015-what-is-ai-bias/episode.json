            "cue": "humans"
          }
        ],
        "color": "#2ECC71"
      }
    },
    {
      "who": "DAD",
      "text": "What can I do as a user?"
    },
    {
      "who": "TEEN",
      "text": "Notice when results seem unfair, report them, and don't treat AI answers as automatically neutral.",
      "board": {
        "type": "checklist",
