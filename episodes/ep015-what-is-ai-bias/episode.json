    },
    {
      "who": "TEEN",
      "text": "It can! AI learns from examples. If the examples are unfair, the AI can copy that unfairness.",
      "board": {
        "type": "big",
        "icon": "warn",
        "text": "Unfair data in → unfair results out",
        "cue": "unfair"
      },
      "punch": "unfair"
    },
    {
      "who": "DAD",
      "text": "How would examples be unfair?"
    },
    {
      "who": "TEEN",
      "text": "Maybe some groups are missing, or old decisions in the data were already biased.",
      "board": {
        "type": "checklist",
        "title": "Unfair data",
        "icon": "warn",
        "items": [
          {
            "text": "Some groups missing",
            "cue": "missing",
            "ok": false
          },
          {
            "text": "Old biased decisions",
            "cue": "old",
            "ok": false
          }
        ]
      }
    },
    {
      "who": "DAD",
      "text": "Give me an example."
    },
    {
      "who": "TEEN",
      "text": "Imagine a face app trained mostly on some faces. It may work worse on faces it rarely saw.",
      "board": {
        "type": "compare",
        "left": {
          "label": "TRAINED ON",
          "color": "#0A84FF",
          "items": [
            {
              "text": "Mostly some faces",
              "icon": "user",
