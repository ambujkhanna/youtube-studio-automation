            }
          ]
        },
        "right": {
          "label": "RESULT",
          "color": "#E91E63",
          "items": [
            {
              "text": "Worse on others",
              "icon": "x",
              "cue": "worse",
              "tick": false
            }
          ]
        }
      }
    },
    {
      "who": "DAD",
      "text": "So how do people fix it?"
    },
    {
      "who": "TEEN",
      "text": "Use more varied data, test results across different groups, and let humans review important decisions.",
      "board": {
        "type": "steps",
        "title": "REDUCING BIAS",
        "items": [
          {
            "label": "More varied data",
