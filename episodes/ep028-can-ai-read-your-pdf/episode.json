    },
    {
      "who": "DAD",
      "text": "Even a scanned paper?"
    },
    {
      "who": "TEEN",
      "text": "Scans are pictures of text, so it has to read the image. Blurry scans cause mistakes.",
      "board": {
        "type": "photo",
        "art": "ain_pdf",
        "caption": "Blurry scans = mistakes",
        "cue": "blurry",
        "icon": "warn"
