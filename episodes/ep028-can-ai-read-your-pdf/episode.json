      "who": "DAD",
      "text": "How do I know it's right?"
    },
    {
      "who": "TEEN",
      "text": "Ask for the page number and the exact quote, then check that page yourself.",
      "board": {
        "type": "checklist",
        "title": "Trust, but check",
        "icon": "search",
        "items": [
          {
            "text": "Page number",
            "cue": "page",
